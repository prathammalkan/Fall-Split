# Fall Split — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or any file containing real secrets.

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ─── App ──────────────────────────────────────────────────────────────────────
# Set the production deployment's public HTTPS origin in its environment.
# Leave blank locally to use the reachable development origin for local testing.
VITE_APP_URL=
VITE_APP_NAME=Fall Split

# ─── Push Notifications (VAPID) ───────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# ─── Sentry Error Monitoring (optional) ───────────────────────────────────────
# App still works without this — just no remote error reporting.
VITE_SENTRY_DSN=

# ─── Analytics (optional — privacy-conscious, no financial data) ───────────────
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com

# ─── Server-side secrets (Supabase Edge Functions / CI only) ──────────────────
# These must NEVER be prefixed with VITE_ (they would leak to the browser bundle).
# Set in Supabase Dashboard → Edge Functions → Secrets, or in CI secrets.

# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # Edge functions only
# VAPID_PRIVATE_KEY=your-vapid-private-key          # Edge functions only
# RESEND_API_KEY=your-resend-api-key                # Transactional email
# SUPABASE_JWT_SECRET=your-jwt-secret               # Edge functions only
